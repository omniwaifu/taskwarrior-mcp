{
  "name": "taskwarrior-mcp",
  "version": "2.0.1",
  "description": "MCP server for taskwarrior",
  "license": "MIT",
  "homepage": "https://github.com/omniwaifu/taskwarrior-mcp",
  "bugs": "https://github.com/omniwaifu/taskwarrior-mcp/issues",
  "packageManager": "bun@1.3.5",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "taskwarrior-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node --target=node22 --format=esm && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build && bun run typecheck",
    "start": "node dist/index.js",
    "dev": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node --target=node22 --format=esm --watch",
    "watch": "bun run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "mcpb:prepare": "bun run build && node scripts/prepare-mcpb.mjs",
    "mcpb:validate": "bun run mcpb:prepare && node scripts/mcpb.mjs validate .mcpb-build",
    "mcpb:pack": "bun run mcpb:prepare && node scripts/mcpb.mjs pack .mcpb-build dist/taskwarrior-mcp.mcpb",
    "mcpb:info": "node scripts/mcpb.mjs info dist/taskwarrior-mcp.mcpb",
    "doctor": "node dist/index.js --doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "^0.28",
    "eslint": "^10",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "ajv": "6.15.0",
    "fflate": "0.8.3"
  },
  "overrides": {
    "ip-address": "^10.7.4",
    "body-parser": "^2.4.0",
    "qs": "^6.17.1",
    "fast-uri": "^3.1.9",
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
