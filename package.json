{
  "name": "taskwarrior-mcp",
  "version": "1.0.3",
  "description": "MCP server for taskwarrior",
  "license": "MIT",
  "homepage": "https://github.com/omniwaifu/taskwarrior-mcp",
  "bugs": "https://github.com/omniwaifu/taskwarrior-mcp/issues",
  "packageManager": "bun@1.3.5",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "taskwarrior-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node --format=esm && shx chmod +x dist/*.js",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build && bun run typecheck",
    "start": "node dist/index.js",
    "dev": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node --format=esm --watch",
    "watch": "bun run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "mcpb:prepare": "bun run build && node scripts/prepare-mcpb.mjs",
    "mcpb:validate": "bun run mcpb:prepare && mcpb validate .mcpb-build",
    "mcpb:pack": "bun run mcpb:prepare && mcpb pack .mcpb-build dist/taskwarrior-mcp.mcpb",
    "mcpb:info": "mcpb info dist/taskwarrior-mcp.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28",
    "eslint": "^10",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17",
    "shx": "^0.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
